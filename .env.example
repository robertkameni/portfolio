# PostgreSQL connection string (required)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres?schema=public

# Optional: override serverless pool size (default: 2 in production, 10 in development)
# Use 1 when pointing DATABASE_URL at Prisma Accelerate or PgBouncer.
# DATABASE_POOL_MAX=2

# Redis for distributed rate limiting (required in production on Vercel)
UPSTASH_REDIS_URL=
# REDIS_URL=

# JWT secrets for admin auth (required in production)
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Optional: realtime session signing (falls back to demo secret in development)
# REALTIME_SESSION_TOKEN_SECRET=

# Optional: AI features
# DEEPSEEK_API_KEY=
# DEEPSEEK_API_BASE_URL=
# DEEPSEEK_CHAT_MODEL=
# DEEPSEEK_VISITOR_MODEL=
