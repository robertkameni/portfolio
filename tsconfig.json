{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022", "dom"],
    "useDefineForClassFields": false,
    "skipLibCheck": true
  },
  // This file is the only tsconfig the TypeScript server discovers on its own:
  // it looks for a file named `tsconfig.json` in each ancestor directory. The
  // other configs are only loaded when a tool is told to use them (`tsc -p`).
  //
  // So a file excluded here belongs to no project the editor can see, and the
  // server falls back to an inferred project with `moduleResolution: classic`
  // and no `@types/node`. That is what made `src/design-system.spec.ts` report
  // "Cannot find name 'node:path'" and an implicit `any` on a `String.replace`
  // callback, while `npm run typecheck` passed: the two were reading different
  // programs.
  //
  // Specs therefore stay in scope here, and the builds that must not see them
  // exclude them explicitly. App and server are whitelists already; they say so
  // out loud rather than relying on inheritance from this file.
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
