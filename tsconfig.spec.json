/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "target": "es2022",
    "types": ["node", "vitest/globals"]
  },
  // Both lists are explicit. The base config used to exclude `src/**/*.spec.ts`,
  // and that inherited exclude beat this `include`, which meant the specs were
  // in no project at all and the editor invented one for them (see the note in
  // tsconfig.json). The base no longer excludes specs, so nothing is cleared
  // here any more.
  "files": ["src/test-setup.ts"],
  "include": ["src/**/*.spec.ts", "src/**/*.d.ts", "src/app/**/*.ts"]
}
