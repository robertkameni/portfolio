{
  // Workspace-scoped editor defaults for Angular + Analog + Vite (does not affect personal user settings).
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.page.ts": "${capture}.page.html, ${capture}.page.css, ${capture}.page.scss",
    "*.ts": "${capture}.spec.ts"
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.angular/cache": true,
    "**/.nitro": true,
    "**/.vercel": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/.angular/cache/**": true,
    "**/.nitro/**": true
  }
}
