{
  "name": "robert-kamenis-cv",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.1"
  },
  "scripts": {
    "ng": "ng",
    "dev": "vite",
    "start": "npm run dev",
    "build": "vite build",
    "watch": "vite build --watch",
    "lint": "eslint \"src/**/*.ts\" middleware.ts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest",
    "test:ci": "vitest run --passWithNoTests",
    "verify": "npm run lint && npm run typecheck && npm run test:ci",
    "backfill:project-images": "tsx scripts/backfill-project-cover-images.ts",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,scss,json}\"",
    "format": "prettier --write \"src/**/*.{ts,html,css,scss,json}\"",
    "format:fix": "npm run format",
    "build:analyze": "node scripts/build-analyze.mjs",
    "check:bundles": "node scripts/check-bundle-budgets.mjs",
    "preview": "vite preview --outDir dist/client --host localhost --port 4173 --strictPort",
    "postinstall": "prisma generate"
  },
  "private": true,
  "dependencies": {
    "@analogjs/router": "^2.7.1",
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/platform-server": "^22.1.4",
    "@angular/router": "^22.1.4",
    "@ngrx/signals": "^22.0.0",
    "@ngrx/store": "^22.0.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@vercel/functions": "^3.9.5",
    "bcrypt": "^6.0.0",
    "h3": "^1.15.11",
    "jsonwebtoken": "^9.0.3",
    "marked": "^18.0.11",
    "pg": "^8.23.0",
    "postcss": "^8.5.26",
    "redis": "^6.2.1",
    "resend": "^6.25.0",
    "rxjs": "~7.8.2",
    "sanitize-html": "^2.17.7",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@analogjs/platform": "^2.7.1",
    "@analogjs/vite-plugin-angular": "^2.7.1",
    "@analogjs/vitest-angular": "^2.7.1",
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.0",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "overrides": {
    "marked": "^18.0.11",
    "brace-expansion": "^5.0.9",
    "esbuild": "^0.28.1",
    "fast-uri": "^3.1.6",
    "hono": "^4.13.5",
    "deepmerge-ts": "^8.0.2",
    "front-matter": {
      "js-yaml": "^3.15.2"
    },
    "xmlbuilder2": {
      "js-yaml": "^4.3.2"
    },
    "@hono/node-server": "^2.0.5",
    "@ngrx/signals": {
      "@angular/common": "^22.1.4",
      "@angular/core": "^22.1.4"
    }
  }
}
