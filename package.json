{
  "name": "robert-kamenis-cv",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.1"
  },
  "scripts": {
    "ng": "ng",
    "dev": "vite",
    "start": "npm run dev",
    "build": "vite build",
    "watch": "vite build --watch",
    "lint": "eslint \"src/**/*.ts\" middleware.ts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest",
    "test:ci": "vitest run --passWithNoTests",
    "verify": "npm run lint && npm run typecheck && npm run test:ci",
    "backfill:project-images": "tsx scripts/backfill-project-cover-images.ts",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,scss,json}\"",
    "format": "prettier --write \"src/**/*.{ts,html,css,scss,json}\"",
    "format:fix": "lint-staged",
    "build:analyze": "node scripts/build-analyze.mjs",
    "check:bundles": "node scripts/check-bundle-budgets.mjs",
    "preview": "vite preview --outDir dist/client --host localhost --port 4173 --strictPort",
    "postinstall": "prisma generate",
    "prepare": "husky"
  },
  "private": true,
  "lint-staged": {
    "src/**/*.{ts,html,css,scss,json}": "prettier --write"
  },
  "dependencies": {
    "@analogjs/router": "^2.9.6",
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@angular/platform-server": "^22.2.5",
    "@angular/router": "^22.2.5",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@ngrx/signals": "^22.0.1",
    "@ngrx/store": "^22.0.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@vercel/functions": "^3.11.0",
    "bcrypt": "^6.0.0",
    "h3": "^1.15.11",
    "jsonwebtoken": "^9.0.3",
    "marked": "^18.1.3",
    "pg": "^8.23.1",
    "postcss": "^8.5.32",
    "redis": "^6.3.1",
    "resend": "^6.37.0",
    "rxjs": "~7.8.2",
    "sanitize-html": "^2.18.1",
    "tailwindcss": "^4.3.5",
    "tslib": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@analogjs/platform": "^2.9.6",
    "@analogjs/vite-plugin-angular": "^2.9.6",
    "@analogjs/vitest-angular": "^2.9.6",
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/sanitize-html": "^2.16.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "dotenv": "^18.0.9",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "rollup-plugin-visualizer": "^7.1.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "overrides": {
    "marked": "^18.1.3",
    "esbuild": "^0.28.1",
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "@hono/node-server": "^2.0.5",
    "mysql2": "^3.23.1"
  }
}
