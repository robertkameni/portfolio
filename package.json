{
  "name": "robert-kamenis-cv",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.1"
  },
  "scripts": {
    "ng": "ng",
    "dev": "vite",
    "start": "npm run dev",
    "build": "vite build",
    "watch": "vite build --watch",
    "lint": "eslint \"src/**/*.ts\" middleware.ts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "test": "vitest",
    "test:ci": "vitest run --passWithNoTests",
    "verify": "npm run lint && npm run typecheck && npm run test:ci",
    "backfill:project-images": "tsx scripts/backfill-project-cover-images.ts",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,scss,json}\"",
    "format": "prettier --write \"src/**/*.{ts,html,css,scss,json}\"",
    "preview": "vite preview --outDir dist/client --host localhost --port 4173 --strictPort",
    "postinstall": "prisma generate"
  },
  "private": true,
  "dependencies": {
    "@analogjs/content": "^2.6.0",
    "@analogjs/router": "^2.6.0",
    "@angular/animations": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@ngrx/signals": "^21.1.0",
    "@oxc-project/runtime": "^0.134.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@vercel/functions": "^3.6.2",
    "bcrypt": "^6.0.0",
    "front-matter": "^4.0.2",
    "jsonwebtoken": "^9.0.3",
    "marked": "^18.0.5",
    "marked-gfm-heading-id": "^4.1.4",
    "marked-highlight": "^2.2.4",
    "marked-mangle": "^1.1.13",
    "pg": "^8.21.0",
    "postcss": "^8.5.15",
    "prismjs": "^1.30.0",
    "redis": "^6.0.0",
    "rxjs": "~7.8.2",
    "tailwindcss": "^4.3.0",
    "tslib": "^2.8.1",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@analogjs/platform": "^2.6.0",
    "@analogjs/vite-plugin-angular": "^2.6.0",
    "@analogjs/vitest-angular": "^2.6.0",
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.1",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "autoprefixer": "^10.5.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.4.1",
    "jsdom": "^29.1.1",
    "npm-check-updates": "^22.2.2",
    "prettier": "^3.8.3",
    "prisma": "^7.8.0",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  }
}
